{
  "name": "@pipeshift/sdk",
  "version": "0.7.0",
  "description": "Settlement SDK for tokenized equities on Robinhood Chain: atomic DVP, multilateral netting, canonical asset registry.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "npm run build && tsc --noEmit",
    "test": "npm run build && node --test --experimental-strip-types test/*.test.ts",
    "clean": "rm -rf dist",
    "e2e": "node --test --experimental-strip-types e2e/settle.e2e.ts",
    "e2e:full": "npm run build && node e2e/run.mjs",
    "devnet": "cd ../contracts && forge script script/Devnet.s.sol --rpc-url ${PIPESHIFT_RPC_URL:-http://127.0.0.1:8545} --broadcast",
    "e2e:fork": "npm run build && PIPESHIFT_FORK_URL=${PIPESHIFT_FORK_URL:-https://rpc.mainnet.chain.robinhood.com} PIPESHIFT_E2E_PORT=${PIPESHIFT_E2E_PORT:-8551} node e2e/run.mjs"
  },
  "keywords": [
    "settlement",
    "tokenized-equities",
    "delivery-versus-payment",
    "netting",
    "robinhood-chain",
    "rwa"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pipeshiftprotocol/pipeshift.git",
    "directory": "sdk-ts"
  },
  "homepage": "https://pipeshift.trade",
  "dependencies": {
    "viem": "^2.21.0"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "@types/node": "^22.7.0"
  },
  "bin": {
    "pipeshift": "./dist/cli.js"
  }
}